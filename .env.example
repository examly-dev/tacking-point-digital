# Contact form delivery (Resend, https://resend.com). Without a key, messages are
# logged to the console in development and the form shows an error in production.
RESEND_API_KEY=
# Optional. Defaults to "Lighthouse Digital <hello@lighthousedigital.com.au>"; the
# domain must be verified in Resend.
CONTACT_FROM=
# Optional. Defaults to hello@lighthousedigital.com.au.
CONTACT_TO=
