# Contact form delivery (Resend, https://resend.com). Without a key, messages are
# logged to the console in development and the form shows an error in production.
RESEND_API_KEY=
# Optional. Defaults to "Tacking Point Digital <andy@tackingpointdigital.com.au>";
# the domain must be verified in Resend.
CONTACT_FROM=
# Optional. Defaults to andy@tackingpointdigital.com.au.
CONTACT_TO=
# Optional. Formsubmit inbox for the public static site. Defaults to site.email.
NEXT_PUBLIC_CONTACT_INBOX=

# Optional. Plausible domain for the public site (production only). Defaults to
# tackingpointdigital.com.au. Uncomment and leave empty to disable the script.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Private invoice workspace at /invoices (not deployed to GitHub Pages).
# In development, invoices are open if this is empty. In production, set a key.
INVOICE_ACCESS_KEY=
